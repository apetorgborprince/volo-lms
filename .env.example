# Required production secrets
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=choose-your-private-administrator-username
ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
ADMIN_FULL_NAME=System Administrator

# Storage
DATABASE_PATH=instance/volo_lms.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=50

# Deployment
SESSION_COOKIE_SECURE=1
BEHIND_PROXY=1
HOST=127.0.0.1
PORT=5000
